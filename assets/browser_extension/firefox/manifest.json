{
  "manifest_version": 3,
  "name": "Delore Browser Bridge",
  "version": "0.2.0",
  "description": "Shows your open browser tabs inside Delore for one-click routing.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47831/*"],
  "background": {"scripts": ["background.js"]},
  "action": {
    "default_title": "Delore Browser Bridge",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-bridge@delore.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  }
}
